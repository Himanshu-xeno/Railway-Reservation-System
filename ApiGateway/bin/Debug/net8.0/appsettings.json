{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "RailwayReservationSecretKey2026!LongerSecretKeyForHmacSha256",
    "Issuer": "RailwayReservationSystem",
    "Audience": "RailwayReservationClients"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-api-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        }
      },
      "auth-short-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{remainder}" }
        ]
      },
      "trains-api-route": {
        "ClusterId": "train-cluster",
        "Match": {
          "Path": "/api/trains/{**remainder}"
        }
      },
      "trains-short-route": {
        "ClusterId": "train-cluster",
        "Match": {
          "Path": "/trains/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/trains/{remainder}" }
        ]
      },
      "reservations-api-route": {
        "ClusterId": "reservation-cluster",
        "Match": {
          "Path": "/api/reservations/{**remainder}"
        }
      },
      "reservations-short-route": {
        "ClusterId": "reservation-cluster",
        "Match": {
          "Path": "/reservations/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/reservations/{remainder}" }
        ]
      },
      "payments-api-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**remainder}"
        }
      },
      "payments-short-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payments/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/payments/{remainder}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:7001"
          }
        }
      },
      "train-cluster": {
        "Destinations": {
          "train-destination": {
            "Address": "http://localhost:7002"
          }
        }
      },
      "reservation-cluster": {
        "Destinations": {
          "reservation-destination": {
            "Address": "http://localhost:7003"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "http://localhost:7004"
          }
        }
      }
    }
  }
}
