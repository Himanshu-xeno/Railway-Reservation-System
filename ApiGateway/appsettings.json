{
  "JwtSettings": {
    "SecretKey": "RailwayReservationSystemSuperSecretKey20261123!@#$",
    "Issuer": "RailwayReservationSystem",
    "Audience": "RailwayReservationSystemClients",
    "ExpiryMinutes": 120
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "trains-route": {
        "ClusterId": "train-cluster",
        "Match": {
          "Path": "/trains/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/trains/{**catch-all}" }
        ]
      },
      "reservations-route": {
        "ClusterId": "reservation-cluster",
        "Match": {
          "Path": "/reservations/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/reservations/{**catch-all}" }
        ]
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payments/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/payments/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:7001/"
          }
        }
      },
      "train-cluster": {
        "Destinations": {
          "train-service": {
            "Address": "http://localhost:7002/"
          }
        }
      },
      "reservation-cluster": {
        "Destinations": {
          "reservation-service": {
            "Address": "http://localhost:7003/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-service": {
            "Address": "http://localhost:7004/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
