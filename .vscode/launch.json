{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ApiGateway (Port 7000)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-apigateway",
      "program": "${workspaceFolder}/ApiGateway/bin/Debug/net10.0/ApiGateway.dll",
      "args": [],
      "cwd": "${workspaceFolder}/ApiGateway",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openUrl",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:7000"
      }
    },
    {
